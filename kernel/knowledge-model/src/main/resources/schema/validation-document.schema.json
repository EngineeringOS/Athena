{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.dev/schema/validation-document.json",
  "schemaVersion": 1,
  "type": "object",
  "required": ["$schema", "schemaVersion", "state", "requirements", "satisfaction", "judgements"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "https://athena.dev/schema/validation-document.json"},
    "schemaVersion": {"type": "integer", "const": 1},
    "state": {"enum": ["READY", "INCOMPLETE", "INVALID"]},
    "requirements": {"type": "array", "x-athena-order": "STABLE_ID", "items": {"type": "object", "required": ["id", "capability"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "capability": {"type": "string"}}}},
    "satisfaction": {"type": "array", "x-athena-order": "STABLE_ID", "items": {"type": "object", "required": ["requirementId", "status"], "additionalProperties": false, "properties": {"requirementId": {"type": "string"}, "status": {"enum": ["SATISFIED", "UNSATISFIED", "UNRESOLVED"]}}}},
    "judgements": {"type": "array", "x-athena-order": "STABLE_ID", "items": {"type": "object", "required": ["id", "status", "problem"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "status": {"type": "string"}, "problem": {"type": "string"}}}}
  }
}
