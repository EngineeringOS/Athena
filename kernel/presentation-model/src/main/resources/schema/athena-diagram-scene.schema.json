{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://athena.dev/schema/presentation/v1/athena-diagram-scene.schema.json",
  "title": "AthenaDiagramScene",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sceneId", "inputRevision", "sceneDigest", "page", "plotFrame", "snapGrid", "styles", "assets", "occurrences", "connections", "decorations", "traces"],
  "properties": {
    "schemaVersion": {"const": 2},
    "sceneId": {"$ref": "#/$defs/sceneId"},
    "inputRevision": {"$ref": "#/$defs/inputRevision"},
    "sceneDigest": {"$ref": "#/$defs/digest"},
    "page": {"$ref": "#/$defs/page"},
    "plotFrame": {"$ref": "#/$defs/plotFrame"},
    "snapGrid": {"$ref": "#/$defs/snapGrid"},
    "styles": {"type": "array", "x-athena-order": "styleId", "items": {"$ref": "#/$defs/style"}},
    "assets": {"type": "array", "x-athena-order": "assetId", "items": {"$ref": "#/$defs/asset"}},
    "occurrences": {"type": "array", "x-athena-order": "zIndex,elementId", "items": {"$ref": "#/$defs/occurrence"}},
    "connections": {"type": "array", "x-athena-order": "zIndex,connectionId,elementId", "items": {"$ref": "#/$defs/connection"}},
    "decorations": {"type": "array", "x-athena-order": "zIndex,kindRank,elementId", "items": {"$ref": "#/$defs/decoration"}},
    "traces": {"type": "array", "x-athena-order": "traceId", "items": {"$ref": "#/$defs/trace"}}
  },
  "$defs": {
    "sceneId": {"type": "string", "pattern": "^scene:sha256:[0-9a-f]{64}$"},
    "elementId": {"type": "string", "pattern": "^[a-z][a-z-]*:sha256:[0-9a-f]{64}$"},
    "styleId": {"type": "string", "pattern": "^style:sha256:[0-9a-f]{64}$"},
    "assetId": {"type": "string", "pattern": "^asset:sha256:[0-9a-f]{64}$"},
    "traceId": {"type": "string", "pattern": "^trace:sha256:[0-9a-f]{64}$"},
    "inputRevision": {"type": "string", "pattern": "^input:sha256:[0-9a-f]{64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}}
    },
    "bounds": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "integer"}, "y": {"type": "integer"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    },
    "page": {
      "type": "object", "additionalProperties": false, "required": ["pageBounds", "drawingBounds"],
      "properties": {"pageBounds": {"$ref": "#/$defs/bounds"}, "drawingBounds": {"$ref": "#/$defs/bounds"}}
    },
    "plotFrame": {
      "type": "object", "additionalProperties": false,
      "required": ["columns", "rows", "columnLabels", "rowLabels"],
      "properties": {
        "columns": {"type": "integer", "minimum": 1},
        "rows": {"type": "integer", "minimum": 1},
        "columnLabels": {"const": "ALPHA"},
        "rowLabels": {"const": "NUMERIC"}
      }
    },
    "snapGrid": {
      "type": "object", "additionalProperties": false,
      "required": ["sheetId", "step", "drawingOrigin", "formulaVersion"],
      "properties": {
        "sheetId": {"type": "string", "minLength": 1}, "step": {"type": "integer", "minimum": 1},
        "drawingOrigin": {"$ref": "#/$defs/point"}, "formulaVersion": {"const": "athena-grid-2"}
      }
    },
    "style": {
      "type": "object", "additionalProperties": false,
      "required": ["styleId", "strokeRgba", "fillRgba", "strokeWidth", "dash", "lineCap", "lineJoin", "fillRule", "opacity", "fontSize", "fontWeight", "textAlign", "textBaseline", "routeMarker", "portDisplay"],
      "properties": {
        "styleId": {"$ref": "#/$defs/styleId"}, "strokeRgba": {"type": "string", "pattern": "^#[0-9a-f]{8}$"},
        "fillRgba": {"type": "string", "pattern": "^#[0-9a-f]{8}$"}, "strokeWidth": {"type": "integer", "minimum": 1},
        "dash": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "lineCap": {"enum": ["BUTT", "ROUND", "SQUARE"]},
        "lineJoin": {"enum": ["MITER", "ROUND", "BEVEL"]},
        "fillRule": {"enum": ["NONZERO", "EVENODD"]},
        "opacity": {"type": "integer", "minimum": 0, "maximum": 255},
        "fontAssetId": {"$ref": "#/$defs/assetId"},
        "fontSize": {"type": "integer", "minimum": 1},
        "fontWeight": {"type": "integer", "minimum": 1, "maximum": 1000},
        "textAlign": {"enum": ["START", "MIDDLE", "END"]},
        "textBaseline": {"enum": ["ALPHABETIC", "MIDDLE", "HANGING"]},
        "routeMarker": {"enum": ["NONE", "END_ARROW"]},
        "portDisplay": {"enum": ["HIDDEN", "MARKER", "MARKER_AND_LABEL"]}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["assetId", "digest", "mediaKind", "profileId", "bundleEntryId", "traceId"],
      "properties": {
        "assetId": {"$ref": "#/$defs/assetId"}, "digest": {"$ref": "#/$defs/digest"}, "mediaKind": {"enum": ["SVG", "PNG", "WOFF2"]},
        "profileId": {"type": "string", "minLength": 1}, "intrinsicBounds": {"$ref": "#/$defs/bounds"},
        "bundleEntryId": {"type": "string", "minLength": 1}, "traceId": {"$ref": "#/$defs/traceId"}
      },
      "oneOf": [
        {"properties": {"mediaKind": {"enum": ["SVG", "PNG"]}, "intrinsicBounds": {"$ref": "#/$defs/bounds"}}, "required": ["intrinsicBounds"]},
        {"properties": {"mediaKind": {"const": "WOFF2"}}, "not": {"required": ["intrinsicBounds"]}}
      ]
    },
    "port": {
      "type": "object", "additionalProperties": false,
      "required": ["elementId", "anchorId", "semanticPortId", "point", "hitRadius", "direction", "styleId", "traceId"],
      "properties": {
        "elementId": {"$ref": "#/$defs/elementId"}, "anchorId": {"type": "string", "minLength": 1}, "semanticPortId": {"type": "string", "pattern": "^port:[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)+$"}, "point": {"$ref": "#/$defs/point"},
        "hitRadius": {"type": "integer", "minimum": 1}, "direction": {"enum": ["IN", "OUT", "BIDIRECTIONAL"]},
        "styleId": {"$ref": "#/$defs/styleId"}, "traceId": {"$ref": "#/$defs/traceId"}
      }
    },
    "label": {
      "type": "object", "additionalProperties": false,
      "required": ["elementId", "role", "text", "anchor", "bounds", "rotationDegrees", "styleId", "traceId"],
      "properties": {
        "elementId": {"$ref": "#/$defs/elementId"}, "role": {"type": "string", "minLength": 1}, "text": {"type": "string"},
        "anchor": {"$ref": "#/$defs/point"}, "bounds": {"$ref": "#/$defs/bounds"}, "rotationDegrees": {"type": "integer"},
        "styleId": {"$ref": "#/$defs/styleId"}, "traceId": {"$ref": "#/$defs/traceId"}
      }
    },
    "occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["elementId", "occurrenceId", "subjectId", "semanticId", "bounds", "placementAnchor", "zIndex", "styleId", "traceId", "ports", "labels"],
      "properties": {
        "elementId": {"$ref": "#/$defs/elementId"}, "occurrenceId": {"type": "string", "minLength": 1}, "subjectId": {"type": "string", "minLength": 1}, "semanticId": {"type": "string", "minLength": 1}, "representationRef": {"type": "string", "minLength": 1},
        "bounds": {"$ref": "#/$defs/bounds"}, "placementAnchor": {"$ref": "#/$defs/point"}, "zIndex": {"type": "integer"},
        "styleId": {"$ref": "#/$defs/styleId"}, "traceId": {"$ref": "#/$defs/traceId"}, "assetId": {"$ref": "#/$defs/assetId"},
        "ports": {"type": "array", "x-athena-order": "semanticPortId,anchorId,elementId", "items": {"$ref": "#/$defs/port"}},
        "labels": {"type": "array", "x-athena-order": "role,elementId", "items": {"$ref": "#/$defs/label"}}
      }
    },
    "connectionSegment": {
      "type": "object", "additionalProperties": false,
      "required": ["segmentId", "start", "end", "kind"],
      "properties": {"segmentId": {"type": "string", "minLength": 1}, "start": {"$ref": "#/$defs/point"}, "end": {"$ref": "#/$defs/point"}, "kind": {"enum": ["ORTHOGONAL", "SHARED"]}}
    },
    "connectionMarker": {
      "type": "object", "additionalProperties": false,
      "required": ["elementId", "kind", "point", "relatedConnectionIds", "bridgeOwner", "traceId"],
      "properties": {"elementId": {"$ref": "#/$defs/elementId"}, "kind": {"enum": ["JUNCTION", "CROSSING", "INTERRUPTION_START", "INTERRUPTION_END"]}, "point": {"$ref": "#/$defs/point"}, "relatedConnectionIds": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "bridgeOwner": {"type": "boolean"}, "traceId": {"$ref": "#/$defs/traceId"}}
    },
    "connectionAnnotation": {
      "type": "object", "additionalProperties": false,
      "required": ["elementId", "semanticId", "displayRole", "value", "anchor", "bounds", "traceId"],
      "properties": {"elementId": {"$ref": "#/$defs/elementId"}, "semanticId": {"type": "string", "minLength": 1}, "displayRole": {"type": "string", "minLength": 1}, "value": {"type": "string", "minLength": 1}, "anchor": {"$ref": "#/$defs/point"}, "bounds": {"$ref": "#/$defs/bounds"}, "traceId": {"$ref": "#/$defs/traceId"}}
    },
    "connection": {
      "type": "object", "additionalProperties": false,
      "required": ["elementId", "connectionId", "projectionId", "sourceAnchorId", "targetAnchorId", "segments", "markers", "annotations", "zIndex", "styleId", "traceId"],
      "properties": {
        "elementId": {"$ref": "#/$defs/elementId"}, "connectionId": {"type": "string", "minLength": 1}, "projectionId": {"type": "string", "minLength": 1}, "sourceAnchorId": {"type": "string", "minLength": 1}, "targetAnchorId": {"type": "string", "minLength": 1},
        "segments": {"type": "array", "minItems": 1, "x-athena-order": "path-order", "items": {"$ref": "#/$defs/connectionSegment"}}, "markers": {"type": "array", "items": {"$ref": "#/$defs/connectionMarker"}}, "annotations": {"type": "array", "items": {"$ref": "#/$defs/connectionAnnotation"}}, "zIndex": {"type": "integer"},
        "styleId": {"$ref": "#/$defs/styleId"}, "traceId": {"$ref": "#/$defs/traceId"}
      }
    },
    "decoration": {
      "type": "object", "additionalProperties": false,
      "required": ["elementId", "kind", "bounds", "zIndex", "styleId", "traceId"],
      "properties": {
        "elementId": {"$ref": "#/$defs/elementId"}, "kind": {"enum": ["PAGE_BACKGROUND", "FRAME_SEGMENT", "COORDINATE_LABEL"]},
        "bounds": {"$ref": "#/$defs/bounds"}, "zIndex": {"type": "integer"}, "styleId": {"$ref": "#/$defs/styleId"},
        "traceId": {"$ref": "#/$defs/traceId"}, "text": {"type": "string"}
      }
    },
    "origin": {
      "type": "object", "additionalProperties": false,
      "required": ["relativePath", "sourceDigest", "role", "startLine", "startCharacter", "endLine", "endCharacter", "subjectId", "primary"],
      "properties": {
        "relativePath": {"type": "string", "minLength": 1}, "sourceDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"enum": ["SEMANTIC_DECLARATION", "PORT_DECLARATION", "RELATIONSHIP_DECLARATION", "SHEET_DECLARATION", "SHEET_PLACEMENT", "ASSET_DEFINITION", "SPATIAL_DERIVATION"]},
        "startLine": {"type": "integer", "minimum": 0}, "startCharacter": {"type": "integer", "minimum": 0},
        "endLine": {"type": "integer", "minimum": 0}, "endCharacter": {"type": "integer", "minimum": 0},
        "subjectId": {"type": "string", "minLength": 1}, "primary": {"type": "boolean"}
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false, "required": ["traceId", "origins"],
      "properties": {"traceId": {"$ref": "#/$defs/traceId"}, "origins": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/origin"}}}
    }
  }
}
