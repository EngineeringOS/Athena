package com.engineeringood.m38.professional

symbol m38_vendor_drive_symbol {
  identity "m38.vendor-drive.symbol"
  version "1.0.0"

  resource vendor_drive_svg {
    kind svg
    path "./svg/vendor-drive.svg"
  }

  graphic svg resource vendor_drive_svg

  anchor supplyL { ref "anchor:supply-l" point (6, 24) role terminal direction in signal Power.family }
  anchor supplyN { ref "anchor:supply-n" point (6, 44) role terminal direction in signal Power.family }
  anchor motorU { ref "anchor:motor-u" point (126, 70) role terminal direction out signal Power.family }
  anchor motorV { ref "anchor:motor-v" point (126, 90) role terminal direction out signal Power.family }
  anchor controlIn { ref "anchor:control-in" point (126, 26) role terminal direction in signal Control.family }
  anchor controlOut { ref "anchor:control-out" point (126, 48) role terminal direction out signal Control.family }
  anchor pe { ref "anchor:pe" point (66, 104) role terminal direction in signal Ground.family }
}

symbol m38_vendor_drive_label_symbol {
  identity "m38.vendor-drive.label.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 132, 16)
    rectangle plate at (0, 0) size (132, 16) style symbol
    label deviceTag at (6, 2) size (120, 12) role device-tag style device-label
  }
}

element m38_vendor_drive_element {
  identity "m38.vendor-drive.element"
  version "1.0.0"
  bounds (0, 0, 132, 128)

  child label { symbol "m38.vendor-drive.label.symbol" translate (0, 0) rotate 0 scale (1, 1) zOrder 0 }
  child body { symbol "m38.vendor-drive.symbol" translate (0, 16) rotate 0 scale (1, 1) zOrder 1 }
  export anchor supplyL from body.supplyL
  export anchor supplyN from body.supplyN
  export anchor motorU from body.motorU
  export anchor motorV from body.motorV
  export anchor controlIn from body.controlIn
  export anchor controlOut from body.controlOut
  export anchor pe from body.pe
  export label deviceTag from label.deviceTag
}

symbol m38_terminal_symbol {
  identity "m38.terminal.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 96, 64)
    rectangle body at (16, 8) size (64, 48) style terminal
    line input from (0, 20) to (16, 20) style conductor
    line output from (96, 20) to (80, 20) style conductor
    line pe from (96, 48) to (80, 48) style conductor
    label deviceTag at (28, 30) size (40, 12) role device-tag style device-label
  }

  anchor input { ref "input" point (0, 20) role terminal direction in signal Control.family }
  anchor output { ref "output" point (96, 20) role terminal direction out signal Control.family }
  anchor pe { ref "pe" point (96, 48) role terminal direction out signal Ground.family }
}

element m38_terminal_element {
  identity "m38.terminal.element"
  version "1.0.0"
  bounds (0, 0, 96, 64)

  child glyph { symbol "m38.terminal.symbol" translate (0, 0) rotate 0 scale (1, 1) zOrder 0 }
  export anchor input from glyph.input
  export anchor output from glyph.output
  export anchor pe from glyph.pe
  export label deviceTag from glyph.deviceTag
}

symbol m38_power_source_symbol {
  identity "m38.power-source.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 96, 72)
    rectangle body at (18, 10) size (58, 52) style symbol
    line lplus from (96, 20) to (76, 20) style conductor
    line lminus from (96, 38) to (76, 38) style conductor
    line pe from (48, 72) to (48, 62) style conductor
    label deviceTag at (24, 28) size (42, 12) role device-tag style device-label
  }

  anchor lplus { ref "lplus" point (96, 20) role terminal direction out signal Power.family }
  anchor lminus { ref "lminus" point (96, 38) role terminal direction out signal Power.family }
  anchor pe { ref "pe" point (48, 72) role terminal direction out signal Ground.family }
}

element m38_power_source_element {
  identity "m38.power-source.element"
  version "1.0.0"
  bounds (0, 0, 96, 72)

  child glyph { symbol "m38.power-source.symbol" translate (0, 0) rotate 0 scale (1, 1) zOrder 0 }
  export anchor lplus from glyph.lplus
  export anchor lminus from glyph.lminus
  export anchor pe from glyph.pe
  export label deviceTag from glyph.deviceTag
}

symbol m38_breaker_symbol {
  identity "m38.breaker.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 80, 88)
    line line from (40, 0) to (40, 30) style conductor
    line load from (40, 58) to (40, 88) style conductor
    circle fixedContact center (40, 30) radius 3 style terminal
    circle movingPivot center (40, 58) radius 3 style terminal
    line blade from (40, 54) to (56, 34) style symbol
    label deviceTag at (8, 38) size (42, 12) role device-tag style device-label
  }

  anchor line { ref "line" point (40, 0) role terminal direction in signal Power.family }
  anchor load { ref "load" point (40, 88) role terminal direction out signal Power.family }
}

element m38_breaker_element {
  identity "m38.breaker.element"
  version "1.0.0"
  bounds (0, 0, 80, 88)

  child glyph { symbol "m38.breaker.symbol" translate (0, 0) rotate 0 scale (1, 1) zOrder 0 }
  export anchor line from glyph.line
  export anchor load from glyph.load
  export label deviceTag from glyph.deviceTag
}

symbol m38_motor_symbol {
  identity "m38.motor.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 112, 96)
    circle body center (56, 48) radius 30 style symbol
    line u from (0, 30) to (28, 30) style conductor
    line v from (0, 66) to (28, 66) style conductor
    line pe from (112, 48) to (86, 48) style conductor
    label deviceTag at (44, 42) size (28, 12) role device-tag style device-label
  }

  anchor u { ref "u" point (0, 30) role terminal direction in signal Power.family }
  anchor v { ref "v" point (0, 66) role terminal direction in signal Power.family }
  anchor pe { ref "pe" point (112, 48) role terminal direction in signal Ground.family }
}

element m38_motor_element {
  identity "m38.motor.element"
  version "1.0.0"
  bounds (0, 0, 112, 96)

  child glyph { symbol "m38.motor.symbol" translate (0, 0) rotate 0 scale (1, 1) zOrder 0 }
  export anchor u from glyph.u
  export anchor v from glyph.v
  export anchor pe from glyph.pe
  export label deviceTag from glyph.deviceTag
}

symbol m38_protective_earth_symbol {
  identity "m38.protective-earth.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 80, 64)
    line bond from (40, 0) to (40, 24) style conductor
    line earthA from (20, 24) to (60, 24) style symbol
    line earthB from (28, 34) to (52, 34) style symbol
    line earthC from (34, 44) to (46, 44) style symbol
    label deviceTag at (18, 50) size (44, 12) role device-tag style device-label
  }

  anchor bond { ref "bond" point (40, 0) role terminal direction out signal Ground.family }
}

element m38_protective_earth_element {
  identity "m38.protective-earth.element"
  version "1.0.0"
  bounds (0, 0, 80, 64)

  child glyph { symbol "m38.protective-earth.symbol" translate (0, 0) rotate 0 scale (1, 1) zOrder 0 }
  export anchor bond from glyph.bond
  export label deviceTag from glyph.deviceTag
}
