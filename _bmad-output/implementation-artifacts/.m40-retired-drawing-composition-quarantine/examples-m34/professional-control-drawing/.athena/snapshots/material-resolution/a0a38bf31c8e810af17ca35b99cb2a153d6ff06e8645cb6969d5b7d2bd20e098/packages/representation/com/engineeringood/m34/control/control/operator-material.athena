symbol iec_lamp {
  identity "iec.lamp.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 80, 88)
    line signalLead from (40, 0) to (40, 20) style conductor
    line returnLead from (40, 68) to (40, 88) style conductor
    circle lampBody center (40, 44) radius 24 style symbol
    line filamentA from (24, 28) to (56, 60) style symbol
    line filamentB from (56, 28) to (24, 60) style symbol
    label deviceTag at (0, 0) size (34, 12) role device-tag style device-label
