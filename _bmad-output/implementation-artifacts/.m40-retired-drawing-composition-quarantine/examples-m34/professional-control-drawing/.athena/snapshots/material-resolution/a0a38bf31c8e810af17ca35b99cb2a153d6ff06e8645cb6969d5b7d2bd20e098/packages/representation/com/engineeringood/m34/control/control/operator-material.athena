package com.engineeringood.m34.control.control

symbol iec_push_button_no {
  identity "iec.push-button.no.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 80, 88)
    line commonLead from (40, 0) to (40, 30) style conductor
    line switchedLead from (40, 58) to (40, 88) style conductor
    circle fixedContact center (40, 30) radius 3 style terminal
    circle movingPivot center (40, 58) radius 3 style terminal
    line movingContact from (40, 54) to (54, 34) style symbol
    line actuatorStem from (58, 18) to (58, 34) style symbol
    line actuatorHead from (50, 18) to (66, 18) style symbol
    label deviceTag at (0, 0) size (34, 12) role device-tag style device-label
  }

  anchor common { primitiveRef commonLead point (40, 0) role terminal accepts direction in accepts signal Control.family }
  anchor switched { primitiveRef switchedLead point (40, 88) role terminal accepts direction out accepts signal Control.family }
}

element iec_push_button_no_element {
  identity "iec.push-button.no.element"
  version "1.0.0"
  bounds (0, 0, 80, 88)

  child glyph { symbol "iec.push-button.no.symbol" translate (0, 0) rotate 0 scale (1, 1) zOrder 0 }
  export anchor common from glyph.common
  export anchor switched from glyph.switched
  export label deviceTag from glyph.deviceTag
}

