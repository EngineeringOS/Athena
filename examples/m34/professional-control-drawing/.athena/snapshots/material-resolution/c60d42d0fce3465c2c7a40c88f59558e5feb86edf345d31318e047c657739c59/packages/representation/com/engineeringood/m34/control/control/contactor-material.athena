  identity "iec.contactor.nc-contact.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 80, 88)
    line auxNc21Lead from (40, 0) to (40, 30) style conductor
    line auxNc22Lead from (40, 58) to (40, 88) style conductor
    circle fixedContact center (40, 30) radius 3 style terminal
    circle movingPivot center (40, 58) radius 3 style terminal
    line closedBlade from (40, 54) to (40, 34) style symbol
    line ncSlash from (30, 36) to (50, 52) style reference
    label deviceTag at (0, 0) size (36, 12) role device-tag style device-label
  }

  anchor auxNc21 { ref "auxNc21Lead" point (40, 0) role terminal direction in signal Control.family }
  anchor auxNc22 { ref "auxNc22Lead" point (40, 88) role terminal direction out signal Control.family }
