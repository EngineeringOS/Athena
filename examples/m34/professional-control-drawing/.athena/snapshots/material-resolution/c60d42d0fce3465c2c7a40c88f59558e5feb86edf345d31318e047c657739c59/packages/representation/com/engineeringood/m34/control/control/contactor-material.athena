package com.engineeringood.m34.control.control

symbol iec_contactor_coil {
  identity "iec.contactor.coil.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 80, 88)
    line coilA1Lead from (40, 0) to (40, 22) style conductor
    line coilA2Lead from (40, 66) to (40, 88) style conductor
    rectangle coilBody at (18, 22) size (44, 44) style symbol
    arc coilTop center (40, 36) radius 10 from 180 sweep 180 style symbol
    arc coilBottom center (40, 52) radius 10 from 0 sweep 180 style symbol
    label deviceTag at (0, 0) size (36, 12) role device-tag style device-label
  }

  anchor coilA1 { ref "coilA1Lead" point (40, 0) role terminal direction in signal Control.family }
  anchor coilA2 { ref "coilA2Lead" point (40, 88) role terminal direction out signal Control.family }
}

element iec_contactor_coil_element {
  identity "iec.contactor.coil.element"
  version "1.0.0"
  bounds (0, 0, 80, 88)

  child glyph { symbol "iec.contactor.coil.symbol" translate (0, 0) rotate 0 scale (1, 1) zOrder 0 }
  export anchor coilA1 from glyph.coilA1
  export anchor coilA2 from glyph.coilA2
  export label deviceTag from glyph.deviceTag
}

symbol iec_contactor_main_contact {
  identity "iec.contactor.main-contact.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 80, 88)
    line mainL1Lead from (40, 0) to (40, 30) style conductor
    line mainT1Lead from (40, 58) to (40, 88) style conductor
    circle fixedContact center (40, 30) radius 3 style terminal
    circle movingPivot center (40, 58) radius 3 style terminal
    line movingContact from (40, 54) to (56, 34) style symbol
    line actuatorMark from (58, 30) to (68, 30) style reference
    label deviceTag at (0, 0) size (36, 12) role device-tag style device-label
  }

  anchor mainL1 { ref "mainL1Lead" point (40, 0) role terminal direction in signal Power.family }
  anchor mainT1 { ref "mainT1Lead" point (40, 88) role terminal direction out signal Power.family }
}

element iec_contactor_main_contact_element {
  identity "iec.contactor.main-contact.element"
  version "1.0.0"
  bounds (0, 0, 80, 88)

  child glyph { symbol "iec.contactor.main-contact.symbol" translate (0, 0) rotate 0 scale (1, 1) zOrder 0 }
  export anchor mainL1 from glyph.mainL1
  export anchor mainT1 from glyph.mainT1
  export label deviceTag from glyph.deviceTag
}

symbol iec_contactor_no_contact {
  identity "iec.contactor.no-contact.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 104, 88)
    line auxNo13Lead from (28, 0) to (28, 30) style conductor
    line auxNo14Lead from (28, 58) to (28, 88) style conductor
    circle auxFixed center (28, 30) radius 3 style terminal
    circle auxPivot center (28, 58) radius 3 style terminal
    line auxBlade from (28, 54) to (42, 34) style symbol
    line statusNo53Lead from (76, 0) to (76, 30) style conductor
    line statusNo54Lead from (76, 58) to (76, 88) style conductor
    circle statusFixed center (76, 30) radius 3 style terminal
    circle statusPivot center (76, 58) radius 3 style terminal
    line statusBlade from (76, 54) to (90, 34) style symbol
    line mechanicalLink from (44, 44) to (62, 44) style reference
    label deviceTag at (0, 0) size (40, 12) role device-tag style device-label
  }

  anchor auxNo13 { ref "auxNo13Lead" point (28, 0) role terminal direction in signal Control.family }
  anchor auxNo14 { ref "auxNo14Lead" point (28, 88) role terminal direction out signal Control.family }
  anchor statusNo53 { ref "statusNo53Lead" point (76, 0) role terminal direction in signal Control.family }
  anchor statusNo54 { ref "statusNo54Lead" point (76, 88) role terminal direction out signal Control.family }
}

element iec_contactor_no_contact_element {
  identity "iec.contactor.no-contact.element"
  version "1.0.0"
  bounds (0, 0, 104, 88)

  child glyph { symbol "iec.contactor.no-contact.symbol" translate (0, 0) rotate 0 scale (1, 1) zOrder 0 }
  export anchor auxNo13 from glyph.auxNo13
  export anchor auxNo14 from glyph.auxNo14
  export anchor statusNo53 from glyph.statusNo53
  export anchor statusNo54 from glyph.statusNo54
  export label deviceTag from glyph.deviceTag
}

