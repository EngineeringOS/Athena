package athena.iec

profile CabinetIEC {
  projection cabinet
  standard IEC
  style athena-industrial-iec-v1
  fallback fail-closed
}

binding M34PowerSupplyCabinet {
  profile CabinetIEC
  priority 160

  select device where {
    type Switch
    model "ATHENA-M34-POWER-SUPPLY"
  }

  use element "cabinet.power_supply.element" version "1.0.0"
  variant "standard"
}

binding M34ProtectiveDeviceCabinet {
  profile CabinetIEC
  priority 150

  select device where {
    type Switch
    model "ATHENA-M34-BREAKER"
  }

  use element "cabinet.protective_device.element" version "1.0.0"
  variant "standard"
}

