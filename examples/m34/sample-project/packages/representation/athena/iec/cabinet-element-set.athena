symbol cabinet_label_symbol {
  identity "cabinet.label.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 120, 24)
    rectangle plate at (0, 0) size (120, 24) style symbol
    label deviceTag at (6, 6) size (108, 12) role device-tag style device-label
  }
}

element cabinet_label_element {
  identity "cabinet.label.element"
  version "1.0.0"
  bounds (0, 0, 120, 24)

  child label {
    symbol "cabinet.label.symbol"
    translate (0, 0)
    rotate 0
    scale (1, 1)
    zOrder 0
  }

  export label deviceTag from label.deviceTag
}
