package athena.iec

symbol iec_folio_continuation_reference_symbol {
  identity "iec.folio-continuation-reference"
  version "1.0.0"

  graphic {
    bounds (0, 0, 42, 20)
    line body from (0, 10) to (32, 10) style conductor
    line head_upper from (32, 10) to (22, 4) style conductor
    line head_lower from (32, 10) to (22, 16) style conductor
  }

  anchor continuation {
    primitiveRef body
    point (32, 10)
    role reference
  }
}

symbol cabinet_enclosure_symbol {
  identity "cabinet.enclosure.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 600, 420)
    line top from (0, 0) to (600, 0) style conductor
    line right from (600, 0) to (600, 420) style conductor
    line bottom from (600, 420) to (0, 420) style conductor
    line left from (0, 420) to (0, 0) style conductor
  }
}

element cabinet_enclosure_element {
  identity "cabinet.enclosure.element"
  version "1.0.0"
  bounds (0, 0, 600, 420)

  child shell {
    symbol "cabinet.enclosure.symbol"
    translate (0, 0)
    rotate 0
    scale (1, 1)
    zOrder 0
  }
}

symbol cabinet_din_rail_symbol {
  identity "cabinet.din_rail.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 520, 24)
    line upper from (0, 8) to (520, 8) style conductor
    line lower from (0, 16) to (520, 16) style conductor
    line notch01 from (24, 4) to (24, 20) style conductor
    line notch02 from (64, 4) to (64, 20) style conductor
    line notch03 from (104, 4) to (104, 20) style conductor
    line notch04 from (144, 4) to (144, 20) style conductor
    line notch05 from (184, 4) to (184, 20) style conductor
    line notch06 from (224, 4) to (224, 20) style conductor
    line notch07 from (264, 4) to (264, 20) style conductor
    line notch08 from (304, 4) to (304, 20) style conductor
    line notch09 from (344, 4) to (344, 20) style conductor
    line notch10 from (384, 4) to (384, 20) style conductor
    line notch11 from (424, 4) to (424, 20) style conductor
    line notch12 from (464, 4) to (464, 20) style conductor
  }
}

element cabinet_din_rail_element {
  identity "cabinet.din_rail.element"
  version "1.0.0"
  bounds (0, 0, 520, 24)

  child rail {
    symbol "cabinet.din_rail.symbol"
    translate (0, 0)
    rotate 0
    scale (1, 1)
    zOrder 0
  }
}

symbol cabinet_protective_device_symbol {
  identity "cabinet.protective_device.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 72, 120)
    line left from (12, 20) to (12, 100) style conductor
    line right from (60, 20) to (60, 100) style conductor
    line top from (12, 20) to (60, 20) style conductor
    line bottom from (12, 100) to (60, 100) style conductor
    line handle from (24, 52) to (48, 40) style conductor
    line line from (36, 0) to (36, 20) style conductor
    line load from (36, 100) to (36, 120) style conductor
  }

  anchor line {
    primitiveRef line
    point (36, 0)
    role terminal
    accepts direction in
    accepts signal Power
  }

  anchor load {
    primitiveRef load
    point (36, 120)
    role terminal
    accepts direction out
    accepts signal Power
  }
}

element cabinet_protective_device_element {
  identity "cabinet.protective_device.element"
  version "1.0.0"
  bounds (0, 0, 72, 120)

  child body {
    symbol "cabinet.protective_device.symbol"
    translate (0, 0)
    rotate 0
    scale (1, 1)
    zOrder 0
  }

  export anchor line from body.line
  export anchor load from body.load
}

symbol cabinet_switch_control_symbol {
  identity "cabinet.switch_control.symbol"
  version "1.0.0"

  graphic {
    bounds (0, 0, 88, 88)
    line plate_top from (16, 16) to (72, 16) style conductor
    line plate_right from (72, 16) to (72, 72) style conductor
    line plate_bottom from (72, 72) to (16, 72) style conductor
    line plate_left from (16, 72) to (16, 16) style conductor
    line actuator_up from (32, 44) to (56, 32) style conductor
    line actuator_down from (32, 56) to (56, 56) style conductor
    line up from (44, 0) to (44, 16) style conductor
    line down from (44, 72) to (44, 88) style conductor
  }

  anchor up {
    primitiveRef up
    point (44, 0)
    role terminal
    accepts direction out
    accepts signal Digital
  }

  anchor down {
    primitiveRef down
    point (44, 88)
    role terminal
    accepts direction out
    accepts signal Digital
  }
}

element cabinet_switch_control_element {
  identity "cabinet.switch_control.element"
  version "1.0.0"
  bounds (0, 0, 88, 88)

  child body {
    symbol "cabinet.switch_control.symbol"
    translate (0, 0)
    rotate 0
    scale (1, 1)
    zOrder 0
  }

  export anchor up from body.up
  export anchor down from body.down
}

