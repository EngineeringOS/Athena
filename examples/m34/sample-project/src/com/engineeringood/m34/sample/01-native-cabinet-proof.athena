package com.engineeringood.m34.sample

system M34NativeCabinetProof {
  entity MainPowerSupplyPS34 {
    concept Switch
    connectivity enabled
    model "ATHENA-M34-POWER-SUPPLY"

    port input {
      direction in
      signal Power
    }

    port output {
      direction out
      signal Power
    }
  }

  entity MainBreakerQF34 {
    concept Switch
    connectivity enabled
    model "ATHENA-M34-BREAKER"

    port line {
      direction in
      signal Power
    }

    port load {
      direction out
      signal Power
    }
  }

  entity WallSwitchS34 {
    concept Switch
    connectivity enabled
    model "ATHENA-M34-WALL-SWITCH"

    port up {
      direction out
      signal Power
    }

    port down {
      direction out
      signal Power
    }
  }

  entity ControlRelayK34 {
    concept Switch
    connectivity enabled
    model "ATHENA-M34-CONTROL-RELAY"

    port supply {
      direction in
      signal Power
    }

    port output {
      direction out
      signal Power
    }
  }

  entity FieldTerminalXT34 {
    concept Switch
    connectivity enabled
    model "ATHENA-M34-FIELD-TERMINAL"

    port field {
      direction in
      signal Power
    }

    port panel {
      direction out
      signal Power
    }
  }

  entity SpareTerminalXT34 {
    concept Switch
    connectivity enabled
    model "ATHENA-M34-SPARE-TERMINAL"

    port field {
      direction in
      signal Power
    }

    port panel {
      direction out
      signal Power
    }
  }

  entity ShutterMotorM34 {
    concept Motor
    connectivity enabled
    model "ATHENA-M34-SHUTTER-MOTOR"

    port up {
      direction in
      signal Power
    }

    port down {
      direction in
      signal Power
    }
  }

  entity PilotLampHL34 {
    concept Lamp
    connectivity enabled
    model "ATHENA-M34-PILOT-LAMP"

    port status {
      direction in
      signal Power
    }
  }

  entity UpperRail34 {
    concept Switch
    connectivity enabled
    model "ATHENA-M34-DIN-RAIL"

    port mount {
      direction in
      signal Digital
    }
  }

  entity LowerRail34 {
    concept Switch
    connectivity enabled
    model "ATHENA-M34-DIN-RAIL"

    port mount {
      direction in
      signal Digital
    }
  }

  entity CabinetEnclosure34 {
    concept Switch
    connectivity enabled
    model "ATHENA-M34-CABINET-ENCLOSURE"

    port body {
      direction in
      signal Digital
    }
  }

  entity RouteChannel34 {
    concept Switch
    connectivity enabled
    model "ATHENA-M34-ROUTE-CHANNEL"

    port channel {
      direction in
      signal Digital
    }
  }

  entity CabinetTitleLabel34 {
    concept Lamp
    connectivity enabled
    model "ATHENA-M34-CABINET-TITLE"

    port label {
      direction in
      signal Digital
    }
  }

  power MainPowerSupplyPS34.output to MainBreakerQF34.line
  power MainBreakerQF34.load to ControlRelayK34.supply
  power ControlRelayK34.output to FieldTerminalXT34.field
  power FieldTerminalXT34.panel to ShutterMotorM34.up
  power WallSwitchS34.up to PilotLampHL34.status
  power WallSwitchS34.down to SpareTerminalXT34.field
  power SpareTerminalXT34.panel to ShutterMotorM34.down

  layout cabinet {
    place MainBreakerQF34 near MainPowerSupplyPS34
    place WallSwitchS34 near MainBreakerQF34
    place ControlRelayK34 near WallSwitchS34
    place FieldTerminalXT34 below MainPowerSupplyPS34
    place SpareTerminalXT34 near FieldTerminalXT34
    place ShutterMotorM34 near SpareTerminalXT34
    place PilotLampHL34 near WallSwitchS34
    place CabinetEnclosure34 near MainPowerSupplyPS34
    place UpperRail34 near CabinetEnclosure34
    place LowerRail34 below UpperRail34
    place RouteChannel34 below FieldTerminalXT34
    place CabinetTitleLabel34 near CabinetEnclosure34
    align MainBreakerQF34 aligned-with MainPowerSupplyPS34 axis horizontal
    align WallSwitchS34 aligned-with MainBreakerQF34 axis horizontal
    align ControlRelayK34 aligned-with WallSwitchS34 axis horizontal
    align SpareTerminalXT34 aligned-with FieldTerminalXT34 axis horizontal
    align ShutterMotorM34 aligned-with SpareTerminalXT34 axis horizontal
    align PilotLampHL34 aligned-with WallSwitchS34 axis horizontal
    align LowerRail34 aligned-with UpperRail34 axis vertical
    group MainPowerSupplyPS34 grouped-with MainBreakerQF34
    group WallSwitchS34 grouped-with ControlRelayK34
    group FieldTerminalXT34 grouped-with SpareTerminalXT34
    group ShutterMotorM34 grouped-with SpareTerminalXT34
    group PilotLampHL34 grouped-with WallSwitchS34
    group RouteChannel34 grouped-with FieldTerminalXT34
    group UpperRail34 grouped-with LowerRail34
  }
}
