package com.engineeringood.m20.sample

system AcceptanceSheetShowcase {
  entity AcceptanceSW1 {
    concept Switch
    model "Main"
  }

  entity AcceptanceM1 {
    concept Motor
  }

  port AcceptanceSW1.out {
    direction out
    signal Control24V
  }

  port AcceptanceM1.in {
    direction in
    signal Control24V
  }

  power AcceptanceSW1.out to AcceptanceM1.in
}
