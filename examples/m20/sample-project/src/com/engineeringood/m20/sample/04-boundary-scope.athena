package com.engineeringood.m20.sample

system BoundaryScopeShowcase {
  entity BoundarySwitch {
    concept Switch
    model "Boundary"
  }

  entity BoundaryLamp {
    concept Lamp
  }

  port BoundarySwitch.out {
    direction out
    signal Control24V
  }

  port BoundaryLamp.in {
    direction in
    signal Control24V
  }

  power BoundarySwitch.out to BoundaryLamp.in
}
