package com.engineeringood.m20.sample

system SchematicSheetShowcase {
  entity SchematicSW1 {
    concept Switch
    model "Main"
  }

  entity SchematicM1 {
    concept Motor
  }

  entity SchematicL1 {
    concept Lamp
  }

  port SchematicSW1.out {
    direction out
    signal Control24V
  }

  port SchematicM1.in {
    direction in
    signal Control24V
  }

  port SchematicL1.in {
    direction in
    signal Control24V
  }

  power SchematicSW1.out to SchematicM1.in
  power SchematicSW1.out to SchematicL1.in
}
