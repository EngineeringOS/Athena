package com.engineeringood.m20.sample

system SchematicSheetShowcase {
  device SchematicSW1 {
    type Switch
    model "Main"
  }

  device SchematicM1 {
    type Motor
  }

  device SchematicL1 {
    type Lamp
  }

  port SchematicSW1.out {
    direction out
    signal Control24V
  }

  port SchematicM1.in {
    direction in
    signal Control24V
  }

  port SchematicL1.in {
    direction in
    signal Control24V
  }

  connect schematicsw1_out_to_schematicm1_in SchematicSW1.out to SchematicM1.in
  connect schematicsw1_out_to_schematicl1_in SchematicSW1.out to SchematicL1.in
}
