package com.engineeringood.m20.sample

system DenseSheetShowcase {
  entity DenseSW1 {
    concept Switch
    model "Main"
  }

  entity DenseM1 {
    concept Motor
  }

  entity DenseM2 {
    concept Motor
  }

  entity DenseL1 {
    concept Lamp
  }

  port DenseSW1.out {
    direction out
    signal Control24V
  }

  port DenseM1.in {
    direction in
    signal Control24V
  }

  port DenseM2.in {
    direction in
    signal Control24V
  }

  port DenseL1.in {
    direction in
    signal Control24V
  }

  power DenseSW1.out to DenseM1.in
  power DenseSW1.out to DenseM2.in
  power DenseSW1.out to DenseL1.in
}
