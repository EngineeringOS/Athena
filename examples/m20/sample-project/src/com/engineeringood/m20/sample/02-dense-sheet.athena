package com.engineeringood.m20.sample

system DenseSheetShowcase {
  device DenseSW1 {
    type Switch
    model "Main"
  }

  device DenseM1 {
    type Motor
  }

  device DenseM2 {
    type Motor
  }

  device DenseL1 {
    type Lamp
  }

  port DenseSW1.out {
    direction out
    signal Control24V
  }

  port DenseM1.in {
    direction in
    signal Control24V
  }

  port DenseM2.in {
    direction in
    signal Control24V
  }

  port DenseL1.in {
    direction in
    signal Control24V
  }

  connect densesw1_out_to_densem1_in DenseSW1.out to DenseM1.in
  connect densesw1_out_to_densem2_in DenseSW1.out to DenseM2.in
  connect densesw1_out_to_densel1_in DenseSW1.out to DenseL1.in
}
