system DuplicateIdentityCabinet {
  device PLC1 {
    type Switch
  }

  device PLC1 {
    type Switch
  }

  port PLC1.out {
    direction out
    signal Digital
  }

  port PLC1.out {
    direction out
    signal Digital
  }

  connect plc1_out_to_plc1_out PLC1.out -> PLC1.out
  connect plc1_out_to_plc1_out_2 PLC1.out -> PLC1.out
}
