system InvalidSemanticCabinet {
  device PLC1 {
    model "S7-1200"
  }

  device M1 {
    type Motor
  }

  port PLC1.out {
    direction out
    signal Digital
  }

  port M1.in {
    direction in
    signal Analog
  }

  connect plc1_out_to_m1_in PLC1.out to M1.in
  connect plc1_out_to_missing_in PLC1.out to Missing.in
}
