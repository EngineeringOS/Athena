system DualDriveCabinet {
  device PLC1 {
    type Switch
  }

  device M1 {
    type Motor
  }

  device M2 {
    type Motor
  }

  port PLC1.out1 {
    direction out
    signal Digital
  }

  port PLC1.out2 {
    direction out
    signal Digital
  }

  port M1.in {
    direction in
    signal Digital
  }

  port M2.in {
    direction in
    signal Digital
  }

  connect plc1_out1_to_m1_in PLC1.out1 to M1.in
  connect plc1_out2_to_m2_in PLC1.out2 to M2.in
}
