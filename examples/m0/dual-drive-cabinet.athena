system DualDriveCabinet {
  entity PLC1 {
    concept Switch
  }

  entity M1 {
    concept Motor
  }

  entity M2 {
    concept Motor
  }

  port PLC1.out1 {
    direction out
    signal Digital
  }

  port PLC1.out2 {
    direction out
    signal Digital
  }

  port M1.in {
    direction in
    signal Digital
  }

  port M2.in {
    direction in
    signal Digital
  }

  power PLC1.out1 to M1.in
  power PLC1.out2 to M2.in
}
