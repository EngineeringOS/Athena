package com.engineeringood.m31.sample

system RollingShutterGovernedAuthoringProof {
  entity MainPowerSupplyPS31 {
    concept Switch
    connectivity enabled
    model "24VDC-PSU"

    port lplus {
      direction out
      flow Digital
    }
  }

  entity MainBreakerQF31 {
    concept Switch
    connectivity enabled
    model "QF"

    port line {
      direction in
      flow Digital
    }

    port load {
      direction out
      flow Digital
    }
  }

  entity WallSwitchS31 {
    concept Switch
    connectivity enabled
    model "UP-DOWN"

    port up {
      direction out
      flow Digital
    }

    port down {
      direction out
      flow Digital
    }
  }

  entity ControlRelayK31 {
    concept Switch
    connectivity enabled
    model "K31"

    port supply {
      direction in
      flow Digital
    }

    port upCommand {
      direction in
      flow Digital
    }

    port downCommand {
      direction in
      flow Digital
    }

    port upOut {
      direction out
      flow Digital
    }

    port downOut {
      direction out
      flow Digital
    }

    port status {
      direction out
      flow Digital
    }

    port spareOut {
      direction out
      flow Digital
    }
  }

  entity FieldTerminalXT31 {
    concept Switch
    connectivity enabled
    model "XT31"

    port controlUp {
      direction in
      flow Digital
    }

    port controlDown {
      direction in
      flow Digital
    }

    port motorUp {
      direction out
      flow Digital
    }

    port motorDown {
      direction out
      flow Digital
    }
  }

  entity ShutterMotorM31 {
    concept Motor
    connectivity enabled
    model "ROLLING-SHUTTER"

    port up {
      direction in
      flow Digital
    }

    port down {
      direction in
      flow Digital
    }
  }

  entity PilotLampHL31 {
    concept Lamp
    connectivity enabled
    model "STATUS"

    port status {
      direction in
      flow Digital
    }
  }

  entity SpareTerminalXT31 {
    concept Switch
    connectivity enabled
    model "SPARE-XT"

    port in1 {
      direction in
      flow Digital
    }
  }

  connect mainpowersupplyps31_lplus_to_mainbreakerqf31_line MainPowerSupplyPS31.lplus to MainBreakerQF31.line
  connect mainbreakerqf31_load_to_controlrelayk31_supply MainBreakerQF31.load to ControlRelayK31.supply
  connect wallswitchs31_up_to_controlrelayk31_upcommand WallSwitchS31.up to ControlRelayK31.upCommand
  connect wallswitchs31_down_to_controlrelayk31_downcommand WallSwitchS31.down to ControlRelayK31.downCommand
  connect controlrelayk31_upout_to_fieldterminalxt31_controlup ControlRelayK31.upOut to FieldTerminalXT31.controlUp
  connect controlrelayk31_downout_to_fieldterminalxt31_controldown ControlRelayK31.downOut to FieldTerminalXT31.controlDown
  connect fieldterminalxt31_motorup_to_shuttermotorm31_up FieldTerminalXT31.motorUp to ShutterMotorM31.up
  connect fieldterminalxt31_motordown_to_shuttermotorm31_down FieldTerminalXT31.motorDown to ShutterMotorM31.down

  connect controlrelayk31_status_to_pilotlamphl31_status ControlRelayK31.status to PilotLampHL31.status

  layout schematic-sheet {
    place MainBreakerQF31 near MainPowerSupplyPS31
    place ControlRelayK31 below MainBreakerQF31
    place WallSwitchS31 near ControlRelayK31
    place FieldTerminalXT31 near ControlRelayK31
    place ShutterMotorM31 below FieldTerminalXT31
    place PilotLampHL31 near WallSwitchS31
    place SpareTerminalXT31 below PilotLampHL31
    align ControlRelayK31 aligned-with MainBreakerQF31 axis vertical
    align ShutterMotorM31 aligned-with FieldTerminalXT31 axis vertical
    group WallSwitchS31 grouped-with ControlRelayK31
    group ShutterMotorM31 grouped-with FieldTerminalXT31
    group SpareTerminalXT31 grouped-with PilotLampHL31
  }
}
