package com.engineeringood.m46.rollingshutter

system rolling_shutter {
  entity Supply {
    concept Supply
    function main {
      role supply
      port L1 { direction out signal Power role line }
    }
  }
  entity Q1 {
    concept Breaker
    function protection {
      role protection
      port inlet { direction in signal Power role line }
      port line { direction out signal Power role line }
    }
  }
  entity KM1 {
    concept Contactor
    function mainContact {
      role switching
      port power { direction in signal Power role line }
      port load { direction out signal Power role line }
    }
    function coil {
      role control
      port control { direction in signal Control role line }
    }
    function auxiliary {
      role auxiliary
      port control { direction in signal Control role line }
      port output { direction out signal Control role line }
    }
  }
  entity OL1 {
    concept Overload
    function protection {
      role protection
      port inlet { direction in signal Power role line }
      port line { direction out signal Power role line }
    }
  }
  entity M1 {
    concept Motor
    function drive {
      role load
      port power { direction in signal Power role line }
    }
  }
  entity PLC1 {
    concept Controller
    function control {
      role controller
      port input { direction in signal Control role line }
      port output { direction out signal Control role line }
    }
  }
  entity S1 {
    concept Sensor
    function limitOpen {
      role sensing
      port output { direction out signal Control role line }
    }
  }
  entity S2 {
    concept Sensor
    function limitClosed {
      role sensing
      port output { direction out signal Control role line }
    }
  }
  entity X1 {
    concept Terminal
    function powerTerminal {
      role terminal
      port inlet { direction in signal Power role line }
      port outlet { direction out signal Power role line }
    }
  }
  entity X2 {
    concept Terminal
    function powerTerminal {
      role terminal
      port inlet { direction in signal Power role line }
      port outlet { direction out signal Power role line }
    }
  }
  entity H1 {
    concept Lamp
    function openLamp {
      role indication
      port inlet { direction in signal Control role line }
    }
  }
  entity H2 {
    concept Lamp
    function closedLamp {
      role indication
      port inlet { direction in signal Control role line }
    }
  }
  entity SpareSource {
    concept Controller
    function io {
      role spare
      port output { direction out signal Control role line }
    }
  }
  entity SpareLoad {
    concept Lamp
    function io {
      role spare
      port input { direction in signal Control role line }
    }
  }

  connection-spec project {
    conductorType copper
  }
  connection-spec potential L1 {
    colorCode black
  }
  connection-spec signal Control24V {
    colorCode black
  }

  connect conductor Supply.main.L1 to Q1.protection.inlet {
    colorCode black
  }
  connect wire Q1.protection.line to KM1.mainContact.power {
    crossSection 0.75 [mm2]
  }
  connect cable-core KM1.mainContact.load to OL1.protection.inlet {
    crossSection 1.5 [mm2]
    conductorType copper
    shielding false
  }
  connect busbar OL1.protection.line to X1.powerTerminal.inlet {
    colorCode black
  }
  net ServiceJumper jumper {
    source X1.powerTerminal.outlet
    sink X2.powerTerminal.inlet
    potential L1
    colorCode black
  }
  connect conductor X2.powerTerminal.outlet to M1.drive.power {
    requiredLength 1.2 [m]
  }

  connect signal S1.limitOpen.output to PLC1.control.input
  connect signal S2.limitClosed.output to PLC1.control.input
  net Control24V signal {
    source PLC1.control.output
    sink KM1.coil.control
    sink H2.closedLamp.inlet
    signal Control24V
    crossSection 0.75 [mm2]
  }
  connect signal KM1.auxiliary.output to H1.openLamp.inlet
  connect signal SpareSource.io.output to SpareLoad.io.input

  view schematic {
    sheet rolling_shutter
    region "Power" {
      occurrences [Supply.main, Q1.protection, KM1.mainContact, OL1.protection, X1.powerTerminal, X2.powerTerminal, M1.drive]
    }
    region "Control" {
      occurrences [PLC1.control, S1.limitOpen, S2.limitClosed, KM1.coil, KM1.auxiliary, H1.openLamp, H2.closedLamp]
    }
  }
}
