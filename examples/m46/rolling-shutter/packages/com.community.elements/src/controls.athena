package com.community.elements

symbol plc { identity "plc" version "1.0.0" resource geometry { kind svg path "resources/plc.svg" } graphic svg resource geometry anchor inlet { port Plc.inlet direction in signal Control point (-1, 0) } anchor outlet { port Plc.outlet direction out signal Control point (1, 0) } }
symbol limit_no { identity "limit_no" version "1.0.0" resource geometry { kind svg path "resources/limit-no.svg" } graphic svg resource geometry anchor inlet { port Limit.inlet direction in signal Control point (0, -1) } anchor outlet { port Limit.outlet direction out signal Control point (0, 1) } }
symbol limit_nc { identity "limit_nc" version "1.0.0" resource geometry { kind svg path "resources/limit-nc.svg" } graphic svg resource geometry anchor inlet { port Limit.inlet direction in signal Control point (0, -1) } anchor outlet { port Limit.outlet direction out signal Control point (0, 1) } }
symbol contact_no { identity "contact_no" version "1.0.0" resource geometry { kind svg path "resources/contact-no.svg" } graphic svg resource geometry anchor inlet { port Contact.inlet direction in signal Control point (0, -1) } anchor outlet { port Contact.outlet direction out signal Control point (0, 1) } }
symbol contact_nc { identity "contact_nc" version "1.0.0" resource geometry { kind svg path "resources/contact-nc.svg" } graphic svg resource geometry anchor inlet { port Contact.inlet direction in signal Control point (0, -1) } anchor outlet { port Contact.outlet direction out signal Control point (0, 1) } }
symbol terminal { identity "terminal" version "1.0.0" resource geometry { kind svg path "resources/terminal.svg" } graphic svg resource geometry anchor inlet { port Terminal.inlet direction in signal Power point (0, -1) } anchor spare { port Terminal.spare direction in signal Power point (1, 0) } anchor outlet { port Terminal.outlet direction out signal Power point (0, 1) } }
symbol lamp { identity "lamp" version "1.0.0" resource geometry { kind svg path "resources/lamp.svg" } graphic svg resource geometry anchor inlet { port Lamp.inlet direction in signal Control point (0, -1) } anchor outlet { port Lamp.outlet direction out signal Control point (0, 1) } }

element plc_element { identity "plc_element" version "1.0.0" child plc { symbol "plc" translate (0, 0) } export anchor inlet from plc.inlet export anchor outlet from plc.outlet }
element limit_no_element { identity "limit_no_element" version "1.0.0" child limit { symbol "limit_no" translate (0, 0) } export anchor inlet from limit.inlet export anchor outlet from limit.outlet }
element limit_nc_element { identity "limit_nc_element" version "1.0.0" child limit { symbol "limit_nc" translate (0, 0) } export anchor inlet from limit.inlet export anchor outlet from limit.outlet }
element contact_no_element { identity "contact_no_element" version "1.0.0" child contact { symbol "contact_no" translate (0, 0) } export anchor inlet from contact.inlet export anchor outlet from contact.outlet }
element contact_nc_element { identity "contact_nc_element" version "1.0.0" child contact { symbol "contact_nc" translate (0, 0) } export anchor inlet from contact.inlet export anchor outlet from contact.outlet }
element terminal_element { identity "terminal_element" version "1.0.0" child terminal { symbol "terminal" translate (0, 0) } export anchor inlet from terminal.inlet export anchor spare from terminal.spare export anchor outlet from terminal.outlet }
element lamp_element { identity "lamp_element" version "1.0.0" child lamp { symbol "lamp" translate (0, 0) } export anchor inlet from lamp.inlet export anchor outlet from lamp.outlet }
