package com.athena.iec
symbol breaker {
  identity "breaker"
  version "1.0.0"
  resource geometry { kind svg path "resources/breaker.svg" }
  graphic svg resource geometry
  anchor inlet { port Breaker.inlet direction in signal Power point (0, -1) }
  anchor line { port Breaker.line direction out signal Power point (0, 1) }
}
element breaker_element {
  identity "breaker_element"
  version "1.0.0"
  child breaker { symbol "breaker" translate (0, 0) }
  export anchor inlet from breaker.inlet
  export anchor line from breaker.line
}
