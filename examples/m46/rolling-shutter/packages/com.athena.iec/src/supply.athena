package com.athena.iec
symbol supply {
  identity "supply"
  version "1.0.0"
  resource geometry { kind svg path "resources/supply.svg" }
  graphic svg resource geometry
  anchor L1 { port Supply.L1 direction out signal Power point (0, 0) }
}
element supply_element {
  identity "supply_element"
  version "1.0.0"
  child supply { symbol "supply" translate (0, 0) }
  export anchor L1 from supply.L1
}
