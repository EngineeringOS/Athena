package com.athena.iec

symbol coil {
  identity "coil"
  version "1.0.0"
  resource geometry { kind svg path "resources/contactor-coil.svg" }
  graphic svg resource geometry
  anchor A1 { port Coil.A1 direction in signal Control point (0, -1) }
  anchor A2 { port Coil.A2 direction out signal Control point (0, 1) }
}

element coil_element {
  identity "coil_element"
  version "1.0.0"
  child coil { symbol "coil" translate (0, 0) }
  export anchor A1 from coil.A1
  export anchor A2 from coil.A2
}
