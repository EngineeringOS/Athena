package com.athena.iec
symbol contactor {
  identity "contactor"
  version "1.0.0"
  resource geometry { kind svg path "resources/contactor-power.svg" }
  graphic svg resource geometry
  anchor power { port Contactor.power direction in signal Power point (0, -1) }
  anchor load { port Contactor.load direction out signal Power point (0, 1) }
}
element contactor_element {
  identity "contactor_element"
  version "1.0.0"
  child contactor { symbol "contactor" translate (0, 0) }
  export anchor power from contactor.power
  export anchor load from contactor.load
}
