package com.engineeringood.m28.sample

system RelationshipRejectionCandidates {
  entity CandidateOutputModuleIOM28 {
    concept Switch
    model "FIELD-IO"

    port do1 {
      direction out
      signal Digital
    }

    port do2 {
      direction out
      signal Digital
    }
  }

  entity CandidateTerminalXT28 {
    concept Switch
    model "XT"

    port in1 {
      direction in
      signal Digital
    }

    port in2 {
      direction in
      signal Digital
    }

    port out1 {
      direction out
      signal Digital
    }
  }

  entity CandidateMotorM28 {
    concept Motor
    model "MOTOR"

    port u1 {
      direction in
      signal Digital
    }
  }

  connect candidateoutputmoduleiom28_do1_to_candidateterminalxt28_in1 CandidateOutputModuleIOM28.do1 to CandidateTerminalXT28.in1
  connect candidateterminalxt28_out1_to_candidatemotorm28_u1 CandidateTerminalXT28.out1 to CandidateMotorM28.u1

  layout schematic-sheet {
    place CandidateTerminalXT28 near CandidateOutputModuleIOM28
    place CandidateMotorM28 below CandidateTerminalXT28
    align CandidateMotorM28 aligned-with CandidateTerminalXT28 axis vertical
    group CandidateTerminalXT28 grouped-with CandidateOutputModuleIOM28
  }
}
