package com.engineeringood.examples.m14.siemens.proof.corpus

system SiemensProofCorpus {
  device PS1 {
    type Switch
    label "24V DC power supply"
    model "evidence.power-supply.24vdc"
  }

  device PLC1 {
    type Switch
    label "PLC CPU 313C"
    model "evidence.cpu.313c"
    note "Narrow Siemens-first proof controller"
  }

  device KM1 {
    type Switch
    label "Power contactor"
    model "evidence.contactor.3pole"
  }

  device FR1 {
    type Switch
    label "Overload relay"
    model "evidence.relay.overload"
  }

  device M1 {
    type Motor
    label "AC motor"
    model "evidence.motor.ac"
  }

  port PS1.out {
    direction out
    signal Power24
  }

  port PLC1.lplus {
    direction out
    signal Power24
  }

  port PLC1.m {
    direction in
    signal Common24
  }

  port PLC1.pe {
    direction in
    signal ProtectiveEarth
  }

  port PLC1.mpi {
    direction out
    signal MPIBus
  }

  connect ps1_out_to_plc1_lplus PS1.out to PLC1.lplus
}
