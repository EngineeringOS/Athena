package com.engineeringood.m29.sample

system InteractionAuthoringProof {
  entity MainPowerSupplyPS1 {
    concept Switch
    model "24VDC-PSU"

    port lplus {
      direction out
      signal Digital
    }
  }

  entity MainBreakerQF1 {
    concept Switch
    model "QF"

    port line {
      direction in
      signal Digital
    }

    port load {
      direction out
      signal Digital
    }
  }

  entity ControllerPLC1 {
    concept Switch
    model "PLC"

    port power {
      direction in
      signal Digital
    }

    port do1 {
      direction out
      signal Digital
    }

    port spareDo {
      direction out
      signal Digital
    }
  }

  entity OperatorHMI1 {
    concept Lamp
    model "HMI"

    port status {
      direction in
      signal Digital
    }
  }

  entity SpareTerminalXT99 {
    concept Switch
    model "SPARE-XT"

    port in1 {
      direction in
      signal Digital
    }
  }

  connect mainpowersupplyps1_lplus_to_mainbreakerqf1_line MainPowerSupplyPS1.lplus to MainBreakerQF1.line
  connect mainbreakerqf1_load_to_controllerplc1_power MainBreakerQF1.load to ControllerPLC1.power
  connect controllerplc1_do1_to_operatorhmi1_status ControllerPLC1.do1 to OperatorHMI1.status

  layout schematic-sheet {
    place MainBreakerQF1 near MainPowerSupplyPS1
    place ControllerPLC1 below MainBreakerQF1
    place OperatorHMI1 near ControllerPLC1
    place SpareTerminalXT99 below OperatorHMI1
    align ControllerPLC1 aligned-with MainBreakerQF1 axis vertical
    group OperatorHMI1 grouped-with ControllerPLC1
  }
}
