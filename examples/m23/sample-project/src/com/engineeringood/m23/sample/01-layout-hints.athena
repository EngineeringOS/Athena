package com.engineeringood.m23.sample

system LayoutHintRoundTrip {
  entity ControllerPLC1 {
    concept Switch
    model "CPU"
  }

  entity OperatorHMI1 {
    concept Lamp
    model "HMI"
  }

  entity TerminalBlockXT1 {
    concept Switch
    model "XT1"
  }

  entity PrimaryLoadM1 {
    concept Motor
    model "M1"
  }

  port ControllerPLC1.command {
    direction out
    signal Digital
  }

  port OperatorHMI1.status {
    direction in
    signal Digital
  }

  port TerminalBlockXT1.in {
    direction in
    signal Digital
  }

  port TerminalBlockXT1.out {
    direction out
    signal Digital
  }

  port PrimaryLoadM1.in {
    direction in
    signal Digital
  }

  power ControllerPLC1.command to OperatorHMI1.status
  power ControllerPLC1.command to TerminalBlockXT1.in
  power TerminalBlockXT1.out to PrimaryLoadM1.in

  layout schematic-sheet {
    place OperatorHMI1 near ControllerPLC1
    place TerminalBlockXT1 below ControllerPLC1
    align OperatorHMI1 aligned-with ControllerPLC1 axis vertical
    group OperatorHMI1 grouped-with ControllerPLC1
  }
}
