package com.engineeringood.m26.sample

system SemanticDocumentProjectionAcceptance {
  entity MainPowerSupplyPS1 {
    concept Switch
    model "24VDC-PSU"
  }

  entity MainBreakerQF1 {
    concept Switch
    model "QF"
  }

  entity ControllerPLC1 {
    concept Switch
    model "PLC"
  }

  entity OperatorHMI1 {
    concept Lamp
    model "HMI"
  }

  port MainPowerSupplyPS1.lplus {
    direction out
    signal Digital
  }

  port MainBreakerQF1.line {
    direction in
    signal Digital
  }

  port MainBreakerQF1.load {
    direction out
    signal Digital
  }

  port ControllerPLC1.power {
    direction in
    signal Digital
  }

  port ControllerPLC1.hmiStatus {
    direction out
    signal Digital
  }

  port OperatorHMI1.status {
    direction in
    signal Digital
  }

  connect mainpowersupplyps1_lplus_to_mainbreakerqf1_line MainPowerSupplyPS1.lplus to MainBreakerQF1.line
  connect mainbreakerqf1_load_to_controllerplc1_power MainBreakerQF1.load to ControllerPLC1.power
  connect controllerplc1_hmistatus_to_operatorhmi1_status ControllerPLC1.hmiStatus to OperatorHMI1.status

  layout schematic-sheet {
    place MainBreakerQF1 near MainPowerSupplyPS1
    place ControllerPLC1 below MainBreakerQF1
    place OperatorHMI1 near ControllerPLC1
    align ControllerPLC1 aligned-with MainBreakerQF1 axis vertical
    group OperatorHMI1 grouped-with ControllerPLC1
  }
}
