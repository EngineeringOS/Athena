system DenseQualifiedNames {
  entity ControllerA {
    concept Switch
    model "CPU-313C"
    note "primary controller"
  }

  entity DriveB {
    concept Motor
    rating "7.5kW"
  }

  port ControllerA.out {
    direction out
    signal Digital
  }

  port DriveB.in {
    direction in
    signal Digital
  }

  connect controllera_out_to_driveb_in ControllerA.out to DriveB.in
}
