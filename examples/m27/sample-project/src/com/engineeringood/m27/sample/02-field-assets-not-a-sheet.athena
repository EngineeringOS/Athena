package com.engineeringood.m27.sample

system ProfessionalSheetProofSupportCatalog {
  entity SpareFieldGatewayGW1 {
    concept Switch
    model "SPARE-GW"
  }

  entity SpareTerminalXT99 {
    concept Switch
    model "SPARE-XT"
  }

  port SpareFieldGatewayGW1.do1 {
    direction out
    signal Digital
  }

  port SpareTerminalXT99.in1 {
    direction in
    signal Digital
  }

  connect sparefieldgatewaygw1_do1_to_spareterminalxt99_in1 SpareFieldGatewayGW1.do1 to SpareTerminalXT99.in1

  layout schematic-sheet {
    place SpareTerminalXT99 below SpareFieldGatewayGW1
  }
}
