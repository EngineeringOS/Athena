package com.engineeringood.m39.realityproductproof

binding M39PowerSource {
  profile ControlDrawingIEC
  priority 900
  select device where { type PowerSource }
  use element "m39.power-source.element" version "1.0.0"
  variant "standard"
}

binding M39Breaker {
  profile ControlDrawingIEC
  priority 900
  select device where { type Breaker }
  use element "m39.breaker.element" version "1.0.0"
  variant "standard"
}

binding M39Drive {
  profile ControlDrawingIEC
  priority 950
  select device where { type Terminal tag "U39" }
  use element "m39.drive.element" version "1.0.0"
  variant "standard"
}

binding M39Button {
  profile ControlDrawingIEC
  priority 900
  select device where { type Terminal tag "S39" }
  use element "m39.button.element" version "1.0.0"
  variant "standard"
}

binding M39Motor {
  profile ControlDrawingIEC
  priority 900
  select device where { type Motor }
  use element "m39.motor.element" version "1.0.0"
  variant "standard"
}

binding M39Earth {
  profile ControlDrawingIEC
  priority 900
  select device where { type ProtectiveEarth }
  use element "m39.earth.element" version "1.0.0"
  variant "standard"
}
