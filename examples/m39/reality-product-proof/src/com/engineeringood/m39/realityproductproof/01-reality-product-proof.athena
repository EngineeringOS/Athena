package com.engineeringood.m39.realityproductproof

system RealityProductProof {
  entity Supply {
    concept PowerSource
    connectivity enabled
    tag "PS39"
    port L1 { direction out flow Power role line terminal "L1" }
    port N { direction out flow Power role neutral terminal "N" }
  }

  entity Breaker {
    concept Breaker
    connectivity enabled
    tag "QF39"
    port line { direction in flow Power role line terminal "1" }
    port load { direction out flow Power role switched terminal "2" }
  }

  entity Drive {
    concept Terminal
    connectivity enabled
    tag "U39"
    port L { direction in flow Power role switched terminal "L" }
    port N { direction in flow Power role neutral terminal "N" }
    port U { direction out flow Power role switched terminal "U" }
    port enable { direction in flow Control role control terminal "DI1" }
    port PE { direction bidirectional flow Ground role protective terminal "PE" }
  }

  entity StartButton {
    concept Terminal
    connectivity enabled
    tag "S39"
    port out { direction out flow Control role control terminal "13" }
  }

  entity Motor {
    concept Motor
    connectivity enabled
    tag "M39"
    port U { direction in flow Power role switched terminal "U" }
    port PE { direction bidirectional flow Ground role protective terminal "PE" }
  }

  entity EarthBar {
    concept ProtectiveEarth
    connectivity enabled
    tag "PE39"
    port PE { direction bidirectional flow Ground role protective terminal "PE" }
  }

  entity Cabinet {
    concept ProtectiveEarth
    connectivity enabled
    tag "CAB39"
    port PE { direction bidirectional flow Ground role protective terminal "PE" }
  }

  power Supply.L1 to Breaker.line
  power Breaker.load to Drive.L
  power Supply.N to Drive.N
  power Drive.U to Motor.U
  control StartButton.out to Drive.enable
  earth EarthBar.PE to [Drive.PE, Motor.PE, Cabinet.PE]

  projection RealityChainView {
    target connection-drawing
    layout orthogonal-grid
    drawingProfile ControlDrawingIEC
    routeQuality ControlDrawingRouteQuality
  }

  layout schematic {
    place Supply at (1, 1) orientation horizontal
    place Breaker at (3, 1) orientation horizontal
    place Drive at (5, 2) orientation horizontal
    place StartButton at (3, 4) orientation horizontal
    place Motor at (7, 2) orientation horizontal
    place EarthBar at (5, 5) orientation horizontal
    place Cabinet at (7, 5) orientation horizontal
  }
}
