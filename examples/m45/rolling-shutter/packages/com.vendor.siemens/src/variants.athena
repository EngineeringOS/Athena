package com.vendor.siemens

variant contactor_main {
  identity "contactor_main"
  version "1.0.0"
  element "siemens_contactor_element"
  resource geometry { kind svg path "resources/siemens-contactor.svg" }
}

variant contactor_coil {
  identity "contactor_coil"
  version "1.0.0"
  element "siemens_contactor_element"
  resource geometry { kind svg path "resources/siemens-contactor.svg" }
}

variant contactor_auxiliary {
  identity "contactor_auxiliary"
  version "1.0.0"
  element "siemens_contactor_element"
  resource geometry { kind svg path "resources/siemens-contactor.svg" }
}

placeholder label {
  identity "label"
  version "1.0.0"
  target "label.text"
  type text
}
