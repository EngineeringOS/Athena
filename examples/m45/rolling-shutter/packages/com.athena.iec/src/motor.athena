package com.athena.iec
symbol motor {
  identity "motor"
  version "1.0.0"
  resource geometry { kind svg path "resources/motor.svg" }
  graphic svg resource geometry
  anchor power { port Motor.power direction in signal Power point (-1, 0) }
}
element motor_element {
  identity "motor_element"
  version "1.0.0"
  child motor { symbol "motor" translate (0, 0) }
  export anchor power from motor.power
}
