package com.community.elements
symbol plc { identity "plc" version "1.0.0" resource geometry { kind svg path "resources/plc.svg" } graphic svg resource geometry anchor inlet { port Plc.inlet direction in signal Control point (-1, 0) } anchor outlet { port Plc.outlet direction out signal Control point (1, 0) } }
symbol sensor { identity "sensor" version "1.0.0" resource geometry { kind svg path "resources/sensor.svg" } graphic svg resource geometry anchor outlet { port Sensor.outlet direction out signal Control point (1, 0) } }
symbol terminal { identity "terminal" version "1.0.0" resource geometry { kind svg path "resources/terminal.svg" } graphic svg resource geometry anchor inlet { port Terminal.inlet direction in signal Power point (-1, 0) } anchor outlet { port Terminal.outlet direction out signal Power point (1, 0) } }
symbol lamp { identity "lamp" version "1.0.0" resource geometry { kind svg path "resources/lamp.svg" } graphic svg resource geometry anchor inlet { port Lamp.inlet direction in signal Control point (-1, 0) } }
element plc_element { identity "plc_element" version "1.0.0" child plc { symbol "plc" translate (0, 0) } export anchor inlet from plc.inlet export anchor outlet from plc.outlet }
element sensor_element { identity "sensor_element" version "1.0.0" child sensor { symbol "sensor" translate (0, 0) } export anchor outlet from sensor.outlet }
element terminal_element { identity "terminal_element" version "1.0.0" child terminal { symbol "terminal" translate (0, 0) } export anchor inlet from terminal.inlet export anchor outlet from terminal.outlet }
element lamp_element { identity "lamp_element" version "1.0.0" child lamp { symbol "lamp" translate (0, 0) } export anchor inlet from lamp.inlet }
