package com.engineeringood.m45.rollingshutter

binding supply_main {
  id "binding-supply-main"
  projection electrical
  role primary
  select function where { subject "function:Supply.main" }
  use element "com.athena.iec/supply_element" version "1.0.0"
}

binding q1_protection {
  id "binding-q1-protection"
  projection electrical
  role primary
  select function where { subject "function:Q1.protection" }
  use element "com.athena.iec/breaker_element" version "1.0.0"
}

binding km1_main {
  id "binding-km1-main"
  projection electrical
  role primary
  select function where { subject "function:KM1.mainContact" }
  use element "com.vendor.siemens/siemens_contactor_element" version "1.0.0"
  variant "com.vendor.siemens/contactor_main@1.0.0"
  placeholders {
    label "KM1-MAIN"
  }
}

binding ol1_protection {
  id "binding-ol1-protection"
  projection electrical
  role primary
  select function where { subject "function:OL1.protection" }
  use element "com.athena.iec/overload_element" version "1.0.0"
}

binding x1_terminal {
  id "binding-x1-terminal"
  projection electrical
  role primary
  select function where { subject "function:X1.powerTerminal" }
  use element "com.community.elements/terminal_element" version "1.0.0"
}

binding m1_drive {
  id "binding-m1-drive"
  projection electrical
  role primary
  select function where { subject "function:M1.drive" }
  use element "com.athena.iec/motor_element" version "1.0.0"
}

binding plc1_control {
  id "binding-plc1-control"
  projection electrical
  role primary
  select function where { subject "function:PLC1.control" }
  use element "com.community.elements/plc_element" version "1.0.0"
}

binding s1_limit {
  id "binding-s1-limit"
  projection electrical
  role primary
  select function where { subject "function:S1.limitOpen" }
  use element "com.community.elements/sensor_element" version "1.0.0"
}

binding s2_limit {
  id "binding-s2-limit"
  projection electrical
  role primary
  select function where { subject "function:S2.limitClosed" }
  use element "com.community.elements/sensor_element" version "1.0.0"
}

binding km1_coil {
  id "binding-km1-coil"
  projection electrical
  role primary
  select function where { subject "function:KM1.coil" }
  use element "com.athena.iec/contactor_element" version "1.0.0"
}

binding km1_auxiliary {
  id "binding-km1-auxiliary"
  projection electrical
  role primary
  select function where { subject "function:KM1.auxiliary" }
  use element "com.athena.iec/contactor_element" version "1.0.0"
}

binding h1_lamp {
  id "binding-h1-lamp"
  projection electrical
  role primary
  select function where { subject "function:H1.openLamp" }
  use element "com.community.elements/lamp_element" version "1.0.0"
}

binding h2_lamp {
  id "binding-h2-lamp"
  projection electrical
  role primary
  select function where { subject "function:H2.closedLamp" }
  use element "com.community.elements/lamp_element" version "1.0.0"
}
