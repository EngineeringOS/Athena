system DualDomainProof {
  entity PLC1 {
    concept Switch
  }

  entity L1 {
    concept Lamp
  }

  entity G1 {
    domain "dummy-runtime"
    concept Glyph
  }

  entity P1 {
    domain "dummy-runtime"
    concept Pulse
  }

  port PLC1.out {
    direction out
    flow Digital
  }

  port L1.in {
    direction in
    flow Digital
  }

  port G1.emit {
    direction out
    flow emit
    tint Amber
  }

  port P1.absorb {
    direction in
    flow absorb
    tint Amber
  }

  connect plc1_out_to_l1_in PLC1.out to L1.in
  connect g1_emit_to_p1_absorb G1.emit to P1.absorb
}
