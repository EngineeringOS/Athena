system DummyProof {
  entity G1 {
    domain "dummy-runtime"
    concept Glyph
  }

  entity P1 {
    domain "dummy-runtime"
    concept Pulse
  }

  port G1.emit {
    direction out
    flow emit
    tint Amber
  }

  port P1.absorb {
    direction in
    flow absorb
    tint Amber
  }

  connect g1_emit_to_p1_absorb G1.emit to P1.absorb
}
