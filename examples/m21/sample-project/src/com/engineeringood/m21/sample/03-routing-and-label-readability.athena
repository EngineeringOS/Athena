package com.engineeringood.m21.sample

system RoutingAndLabelReadability {
  entity RoutePLC1 {
    concept Switch
    model "CPU"
  }

  entity RouteSensorS1 {
    concept Switch
    model "S1"
  }

  entity RouteActuatorY1 {
    concept Lamp
    model "Y1"
  }

  entity RouteTerminalXT2 {
    concept Switch
    model "XT2"
  }

  port RouteSensorS1.out {
    direction out
    signal SensorSignal
  }

  port RoutePLC1.input {
    direction in
    signal SensorSignal
  }

  port RoutePLC1.output {
    direction out
    signal ActuatorCommand
  }

  port RouteTerminalXT2.in {
    direction in
    signal ActuatorCommand
  }

  port RouteTerminalXT2.out {
    direction out
    signal ActuatorCommand
  }

  port RouteActuatorY1.in {
    direction in
    signal ActuatorCommand
  }

  connect routesensors1_out_to_routeplc1_input RouteSensorS1.out to RoutePLC1.input
  connect routeplc1_output_to_routeterminalxt2_in RoutePLC1.output to RouteTerminalXT2.in
  connect routeterminalxt2_out_to_routeactuatory1_in RouteTerminalXT2.out to RouteActuatorY1.in
}
