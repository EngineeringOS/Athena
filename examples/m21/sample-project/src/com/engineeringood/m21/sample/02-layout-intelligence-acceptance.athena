package com.engineeringood.m21.sample

system LayoutIntelligenceAcceptance {
  entity PowerSupply24V {
    concept Switch
    model "24VDC"
  }

  entity ProtectionQF1 {
    concept Switch
    model "QF1"
  }

  entity ControllerPLC1 {
    concept Switch
    model "CPU"
  }

  entity OperatorHMI1 {
    concept Lamp
    model "Panel"
  }

  entity TerminalBlockXT1 {
    concept Switch
    model "XT1"
  }

  entity PrimaryLoadM1 {
    concept Motor
    model "M1"
  }

  port PowerSupply24V.out {
    direction out
    signal Control24V
  }

  port ProtectionQF1.in {
    direction in
    signal Control24V
  }

  port ProtectionQF1.out {
    direction out
    signal Protected24V
  }

  port ControllerPLC1.power {
    direction in
    signal Protected24V
  }

  port OperatorHMI1.power {
    direction in
    signal Protected24V
  }

  port TerminalBlockXT1.in {
    direction in
    signal Protected24V
  }

  port TerminalBlockXT1.out {
    direction out
    signal MotorEnable
  }

  port PrimaryLoadM1.in {
    direction in
    signal MotorEnable
  }

  connect powersupply24v_out_to_protectionqf1_in PowerSupply24V.out to ProtectionQF1.in
  connect protectionqf1_out_to_controllerplc1_power ProtectionQF1.out to ControllerPLC1.power
  connect protectionqf1_out_to_operatorhmi1_power ProtectionQF1.out to OperatorHMI1.power
  connect protectionqf1_out_to_terminalblockxt1_in ProtectionQF1.out to TerminalBlockXT1.in
  connect terminalblockxt1_out_to_primaryloadm1_in TerminalBlockXT1.out to PrimaryLoadM1.in
}
