package com.engineeringood.m21.sample

system BoundaryScopeShowcase {
  device BoundaryPowerSupply {
    type Switch
    model "LocalOnly"
  }

  device BoundaryLoad {
    type Lamp
    model "NoRegistryNoCabinet"
  }

  port BoundaryPowerSupply.out {
    direction out
    signal Boundary24V
  }

  port BoundaryLoad.in {
    direction in
    signal Boundary24V
  }

  connect boundarypowersupply_out_to_boundaryload_in BoundaryPowerSupply.out to BoundaryLoad.in
}
