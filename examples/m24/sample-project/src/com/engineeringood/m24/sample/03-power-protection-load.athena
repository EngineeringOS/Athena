package com.engineeringood.m24.sample

system PowerProtectionRouteProof {
  entity PowerSupplyPS1 {
    concept Switch
    model "24VDC"
  }

  entity BreakerQF1 {
    concept Switch
    model "QF1"
  }

  entity ContactorKM1 {
    concept Switch
    model "KM1"
  }

  entity MotorM1 {
    concept Motor
    model "M1"
  }

  port PowerSupplyPS1.lplus {
    direction out
    signal Digital
  }

  port BreakerQF1.line {
    direction in
    signal Digital
  }

  port BreakerQF1.load {
    direction out
    signal Digital
  }

  port ContactorKM1.a1 {
    direction in
    signal Digital
  }

  port ContactorKM1.t1 {
    direction out
    signal Digital
  }

  port MotorM1.u1 {
    direction in
    signal Digital
  }

  power PowerSupplyPS1.lplus to BreakerQF1.line
  power BreakerQF1.load to ContactorKM1.a1
  power ContactorKM1.t1 to MotorM1.u1

  layout schematic-sheet {
    place BreakerQF1 near PowerSupplyPS1
    place ContactorKM1 below BreakerQF1
    place MotorM1 below ContactorKM1
    align MotorM1 aligned-with ContactorKM1 axis vertical
  }
}
