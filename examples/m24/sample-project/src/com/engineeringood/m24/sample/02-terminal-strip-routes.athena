package com.engineeringood.m24.sample

system TerminalStripRouteProof {
  entity TerminalRoutePLC1 {
    concept Switch
    model "PLC"
  }

  entity TerminalStripXT1 {
    concept Switch
    model "XT1"
  }

  entity ValveY1 {
    concept Lamp
    model "Y1"
  }

  entity SensorB1 {
    concept Switch
    model "B1"
  }

  port TerminalRoutePLC1.do1 {
    direction out
    signal Digital
  }

  port TerminalRoutePLC1.do2 {
    direction out
    signal Digital
  }

  port TerminalStripXT1.in1 {
    direction in
    signal Digital
  }

  port TerminalStripXT1.in2 {
    direction in
    signal Digital
  }

  port TerminalStripXT1.out1 {
    direction out
    signal Digital
  }

  port TerminalStripXT1.out2 {
    direction out
    signal Digital
  }

  port ValveY1.command {
    direction in
    signal Digital
  }

  port SensorB1.feedback {
    direction in
    signal Digital
  }

  power TerminalRoutePLC1.do1 to TerminalStripXT1.in1
  power TerminalRoutePLC1.do2 to TerminalStripXT1.in2
  power TerminalStripXT1.out1 to ValveY1.command
  power TerminalStripXT1.out2 to SensorB1.feedback

  layout schematic-sheet {
    place TerminalStripXT1 below TerminalRoutePLC1
    place ValveY1 near TerminalStripXT1
    place SensorB1 near TerminalStripXT1
    group ValveY1 grouped-with TerminalStripXT1
  }
}
