package engineering.electrical
domain electrical {
  concept motor { kind rotating }
  concept breaker { kind protection }
  concept contactor { kind switching }
  capability switchedPower provides { medium electricalPower }
  capability protectedLoad provides { medium protectedElectricalPower }
  relationship supplies {
    role provider level port
    role consumer level port
    connectivity true
  }
  relationship protects {
    role provider level entity
    role protected level entity
    connectivity false
  }
  flow electricalPower relationship supplies source provider sink consumer medium electricalPower
}
