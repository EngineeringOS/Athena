package com.engineeringood.m41.rollingshutter

system RollingShutter {
  entity Supply {
    concept PowerSource
    connectivity enabled
    tag "PS41"
    port L1 { direction out flow Power role line terminal "L1" }
    port N { direction out flow Power role neutral terminal "N" }
  }

  entity Breaker {
    concept Breaker
    connectivity enabled
    tag "Q41"
    port line { direction in flow Power role line terminal "1" }
    port load { direction out flow Power role switched terminal "2" }
  }

  entity Contactor {
    concept Contactor
    connectivity enabled
    tag "KM41"
    port L { direction in flow Power role switched terminal "L" }
    port N { direction in flow Power role neutral terminal "N" }
    port U { direction out flow Power role switched terminal "U" }
    port contact13 { direction in flow Control role control terminal "13" }
    port contact14 { direction out flow Control role control terminal "14" }
    port coilA1 { direction in flow Control role control terminal "A1" }
    port coilA2 { direction in flow Control role control terminal "A2" }
    port PE { direction bidirectional flow Ground role protective terminal "PE" }
  }

  entity StartButton {
    concept Terminal
    connectivity enabled
    tag "S41"
    port contact13 { direction out flow Control role control terminal "13" }
  }

  entity LimitSwitch {
    concept Terminal
    connectivity enabled
    tag "B41"
    port contact13 { direction out flow Control role control terminal "13" }
  }

  entity Motor {
    concept Motor
    connectivity enabled
    tag "M41"
    port U { direction in flow Power role switched terminal "U" }
    port PE { direction bidirectional flow Ground role protective terminal "PE" }
  }

  entity EarthBar {
    concept ProtectiveEarth
    connectivity enabled
    tag "PE41"
    port PE { direction bidirectional flow Ground role protective terminal "PE" }
  }

  entity Cabinet {
    concept ProtectiveEarth
    connectivity enabled
    tag "CAB41"
    port PE { direction bidirectional flow Ground role protective terminal "PE" }
  }

  power Supply.L1 to Breaker.line
  power Breaker.load to Contactor.L
  power Supply.N to Contactor.N
  power Contactor.U to Motor.U
  control StartButton.contact13 to Contactor.coilA1
  control LimitSwitch.contact13 to Contactor.coilA2
  earth EarthBar.PE to [Contactor.PE, Motor.PE, Cabinet.PE]

  view schematic {
    sheet S1
    grid G1 { rows 8 columns 10 }
    region "Power Distribution" { occurrences [Supply, Breaker] }
    region "Control Logic" { occurrences [StartButton, LimitSwitch, Contactor] }
    region "Load And Protection" { occurrences [Motor, EarthBar, Cabinet] }
    power-rail L1 [Supply.L1, Breaker.line]
    rung R1 [Breaker.load, Contactor.L]
    branch B1 [Contactor.U, Motor.U]
    wire-bundle W1 [Supply.L1, Supply.N]
    terminal-strip X1 [Contactor.L, Contactor.N, Contactor.coilA1, Contactor.PE]
    contact-group C1 [Contactor.contact13, Contactor.contact14]
    coil-group K1 [Contactor.coilA1, Contactor.coilA2]
    reading-order [S1]
  }
}
