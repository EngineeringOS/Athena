package com.engineeringood.m22.sample

system BaselineSheetShowcase {
  entity BaselineSW1 {
    concept Switch
    model "Main"
  }

  entity BaselineM1 {
    concept Motor
  }

  entity BaselineL1 {
    concept Lamp
  }

  port BaselineSW1.out {
    direction out
    signal Control24V
  }

  port BaselineM1.in {
    direction in
    signal Control24V
  }

  port BaselineL1.in {
    direction in
    signal Control24V
  }

  connect baselinesw1_out_to_baselinem1_in BaselineSW1.out to BaselineM1.in
  connect baselinesw1_out_to_baselinel1_in BaselineSW1.out to BaselineL1.in
}
