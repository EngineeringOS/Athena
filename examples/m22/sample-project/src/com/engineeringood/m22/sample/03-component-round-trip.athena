package com.engineeringood.m22.sample

system ComponentRoundTripScenario {
  entity RoundTripControllerPLC1 {
    concept Switch
    model "CPU"
  }

  entity RoundTripHMI1 {
    concept Lamp
    model "HMI"
  }

  entity RoundTripTerminalXT2 {
    concept Switch
    model "XT2"
  }

  entity RoundTripLoadM2 {
    concept Motor
    model "M2"
  }

  port RoundTripControllerPLC1.output {
    direction out
    signal RoundTripCommand
  }

  port RoundTripHMI1.status {
    direction in
    signal RoundTripCommand
  }

  port RoundTripTerminalXT2.in {
    direction in
    signal RoundTripCommand
  }

  port RoundTripTerminalXT2.out {
    direction out
    signal RoundTripCommand
  }

  port RoundTripLoadM2.in {
    direction in
    signal RoundTripCommand
  }

  connect roundtripcontrollerplc1_output_to_roundtriphmi1_status RoundTripControllerPLC1.output to RoundTripHMI1.status
  connect roundtripcontrollerplc1_output_to_roundtripterminalxt2_in RoundTripControllerPLC1.output to RoundTripTerminalXT2.in
  connect roundtripterminalxt2_out_to_roundtriploadm2_in RoundTripTerminalXT2.out to RoundTripLoadM2.in
}
