package com.engineeringood.m22.sample

system LayoutOptimizationAcceptance {
  device PowerSupply24V {
    type Switch
    model "24VDC"
  }

  device ProtectionQF1 {
    type Switch
    model "QF1"
  }

  device ControllerPLC1 {
    type Switch
    model "CPU"
  }

  device OperatorHMI1 {
    type Lamp
    model "Panel"
  }

  device TerminalBlockXT1 {
    type Switch
    model "XT1"
  }

  device PrimaryLoadM1 {
    type Motor
    model "M1"
  }

  port PowerSupply24V.out {
    direction out
    signal Control24V
  }

  port ProtectionQF1.in {
    direction in
    signal Control24V
  }

  port ProtectionQF1.out {
    direction out
    signal Protected24V
  }

  port ControllerPLC1.power {
    direction in
    signal Protected24V
  }

  port OperatorHMI1.power {
    direction in
    signal Protected24V
  }

  port TerminalBlockXT1.in {
    direction in
    signal Protected24V
  }

  port TerminalBlockXT1.out {
    direction out
    signal MotorEnable
  }

  port PrimaryLoadM1.in {
    direction in
    signal MotorEnable
  }

  connect powersupply24v_out_to_protectionqf1_in PowerSupply24V.out -> ProtectionQF1.in
  connect protectionqf1_out_to_controllerplc1_power ProtectionQF1.out -> ControllerPLC1.power
  connect protectionqf1_out_to_operatorhmi1_power ProtectionQF1.out -> OperatorHMI1.power
  connect protectionqf1_out_to_terminalblockxt1_in ProtectionQF1.out -> TerminalBlockXT1.in
  connect terminalblockxt1_out_to_primaryloadm1_in TerminalBlockXT1.out -> PrimaryLoadM1.in
}
