system Anatomy {
  entity Drive {
    concept Drive
    ratedVoltage 400[si.V]
    poleCount 4
    enabled true
    label "Main drive"
    mode automatic
    related @Feeder
    structure core.functional @DriveFunction display "=F1"

    function main {
      role core.main
      port powerIn {
        direction in
        flow Power
      }
    }
  }
}
