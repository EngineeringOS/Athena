system FunctionPlacement {
  entity KM1 {
    concept Contactor
    function coil {
      role coil
      port A1 {
        direction in
        flow Control
        terminal "A1"
      }
      port A2 {
        direction out
        flow Control
        terminal "A2"
      }
    }
  }
  layout schematic {
    place KM1.coil at (7, 4) orientation vertical
    place KM1 at (5, 2) orientation horizontal
  }
}
