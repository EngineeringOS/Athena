system EngineeringConnectivity {
  entity Drive {
    concept MotorDrive
    connectivity enabled

    interface powerInput {
      concept power
      direction in
      flow PowerAC
      role line

      ports {
        L1
        PE {
          flow ProtectiveEarth
          role protective_earth
          direction bidirectional
        }
      }
    }
  }
}
