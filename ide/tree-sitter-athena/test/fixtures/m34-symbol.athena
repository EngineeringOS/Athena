package athena.iec

symbol iec_switch_contact {
  identity "iec.switch_contact"
  version "1.0.0"

  graphic {
    bounds (0, 0, 80, 80)
    line line from (40, 0) to (40, 20) style conductor
    line load from (40, 60) to (40, 80) style conductor
  }

  anchor line {
    ref "line"
    point (40, 0)
    role terminal
    direction in
    signal Power.family
  }

  anchor load {
    ref "load"
    point (40, 80)
    role terminal
    direction out
    signal Power.family
  }
}
